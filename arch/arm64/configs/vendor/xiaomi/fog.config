CONFIG_LOCALVERSION="-Motregen"
CONFIG_CMDLINE="cgroup_disable=pressure"
CONFIG_FAKE_UNAME_5_10=y

# Device specific configs
CONFIG_TARGET_PROJECT_C3Q=y
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_LTO_CLANG=y
CONFIG_TLS=y
CONFIG_PM_WAKELOCKS_GC=y
CONFIG_ANT_CHECK=y
CONFIG_ANT_CHECK_DIV=y
CONFIG_INPUT_FINGERPRINT=y
CONFIG_TOUCHSCREEN_NT36xxx_HOSTDL_SPI=y
CONFIG_TOUCHSCREEN_FTS_SPI=y
CONFIG_FINGERPRINT_FPC1020=y
CONFIG_SILEAD_FP_PLATFORM=y
CONFIG_SMB1351_USB_CHARGER=y
CONFIG_SH36610X_BATTERY=y
CONFIG_LCD_BIAS=y
CONFIG_LCD_BKL=y
CONFIG_WUSB3801_DEBUG=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_QCA_CLD_WLAN=y
CONFIG_EXFAT_FS=y
CONFIG_NTFS_FS=y
CONFIG_DRM_PANEL=y
CONFIG_FB=y

# Compiler
CONFIG_FRAME_WARN=0

# Perf configs
CONFIG_IRQ_SBALANCE=y
CONFIG_IRQ_SBALANCE_POLL_MSEC=20000
CONFIG_IRQ_SBALANCE_THRESH=1024
CONFIG_SBALANCE_EXCLUDE_CPUS="3,7"
CONFIG_LITTLE_CPU_MASK=15
CONFIG_BIG_CPU_MASK=240
CONFIG_ANDROID_SIMPLE_LMK=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_BUCKETS_COUNT=20
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_SCHED_CASS=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# PSTORE
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_LAST_KMSG=y

# Disabled configs
# CONFIG_CPU_BOOST is not set
# CONFIG_SCHED_WALT is not set
# CONFIG_MEMCG is not set
# CONFIG_MEMCG_SWAP is not set
# CONFIG_SCHED_CORE_CTL is not set
# CONFIG_SCHED_TUNE is not set
# CONFIG_ARCH_SCUBA is not set
# CONFIG_ARM64_SW_TTBR0_PAN is not set
# CONFIG_FPR_FPC is not set
# CONFIG_PSI is not set
# CONFIG_CPU_FREQ_TIMES is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_RMI_DEV is not set
# CONFIG_TOUCHSCREEN_FTS is not set
# CONFIG_TOUCHSCREEN_NT36XXX is not set
# CONFIG_PINCTRL_SCUBA is not set
# CONFIG_SMB1398_CHARGER is not set
# CONFIG_QTI_CPU_ISOLATE_COOLING_DEVICE is not set
# CONFIG_REGULATOR_PM8008 is not set
# CONFIG_LEDS_AW2016 is not set
# CONFIG_LEDS_GPIO is not set
# CONFIG_QM_DISPCC_SCUBA is not set
# CONFIG_QM_GPUCC_SCUBA is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DEBUG_BUGVERBOSE is not set
# CONFIG_MSM_IDLE_STATS is not set
# CONFIG_PAGE_OWNER is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_PAGE_EXTENSION is not set
# CONFIG_BT_DEBUGFS is not set
# CONFIG_FRAME_VECTOR is not set
# CONFIG_BLK_DEBUG_FS is not set
# CONFIG_IPC_LOGGING is not set
# CONFIG_IKHEADERS is not set
